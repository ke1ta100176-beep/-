# ===== Zoom (Server-to-Server OAuth) =====
# Zoom Marketplace (https://marketplace.zoom.us/) で
# 「Server-to-Server OAuth」タイプのアプリを作成して取得する
ZOOM_ACCOUNT_ID=your_account_id_here
ZOOM_CLIENT_ID=your_client_id_here
ZOOM_CLIENT_SECRET=your_client_secret_here

# ====== Google (OAuth Client / Desktop app) ======
# Google Cloud Console でプロジェクトを作成し、
# Calendar API / Drive API / Sheets API を有効化したうえで、
# 「OAuth クライアント ID」(種類: デスクトップアプリ) を作成し、
# JSON をダウンロードして client_secret.json として
# このファイルと同じディレクトリに置く（直接ここには書かない）
GOOGLE_CLIENT_SECRET_FILE=client_secret.json
GOOGLE_TOKEN_FILE=token.json

# ====== Google Spreadsheet ======
# スプレッドシートのURLの中にある長い英数字の文字列
# 例: https://docs.google.com/spreadsheets/d/★ここ★/edit
SPREADSHEET_ID=your_spreadsheet_id_here
