# ===== データベース =====
# ローカル開発: ローカルPostgreSQL / 本番: SupabaseのConnection string（Transaction pooler推奨）
DATABASE_URL="postgresql://postgres@localhost:5432/instagram_research"

# ===== 認証（Auth.js） =====
# `openssl rand -base64 32` で生成した32文字以上のランダム文字列
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# ===== AI =====
# Anthropic APIキー（未設定の場合は決定的なスタブAIで動作する）
ANTHROPIC_API_KEY=""
# anthropic | stub
AI_PROVIDER="anthropic"
AI_MODEL="claude-sonnet-5"

# ===== データ取得 =====
# mock | scraping_api（将来実装）
DATA_SOURCE="mock"

# ===== バックグラウンドジョブ =====
# /api/internal/jobs/* を保護する秘密文字列（16文字以上）
CRON_SECRET=""

# ===== その他 =====
APP_TIMEZONE="Asia/Tokyo"
