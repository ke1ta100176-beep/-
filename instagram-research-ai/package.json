    "postinstall": "prisma generate",
    "user:create": "tsx scripts/createUser.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.112.3",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.25.0",
    "next": "15.5.20",
    "next-auth": "^5.0.0-beta.31",
    "papaparse": "^5.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "recharts": "^3.9.2",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
